# Server Configurations
HOST=127.0.0.1
PORT=8000
RELOAD=True

# Database Configuration
# In a local development setup: mongodb://localhost:27017
# In MongoDB Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/
MONGODB_URL=mongodb://localhost:27017
DB_NAME=wareops_erp_db

# Security & Authentications
JWT_SECRET=super_secret_cryptographic_key_replace_in_production_32_bytes_min
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis Configuration (Optional Session / Token Rotation Caching)
REDIS_URL=redis://localhost:6379/0
